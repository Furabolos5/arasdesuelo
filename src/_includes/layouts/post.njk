---
layout: layouts/base.njk
---
<article class="post" style="--tema-color: {{ temasMeta[tema].color }};">
  <div class="post__hero">
    <img src="{{ heroImage | url }}" alt="Ilustración de {{ escuelasMeta[escuela].etiqueta }}: {{ title | escape }}" class="post__hero-img" width="1200" height="630" loading="eager">
    <div class="post__hero-fade"></div>
  </div>

  <div class="wrap wrap--narrow">
    <header class="post__header">
      <nav class="breadcrumb" aria-label="Migas de pan"><a href="{{ '/' | url }}">Inicio</a><span>/</span><a href="{{ '/ensayos/' | url }}">Ensayos</a></nav>
      <div class="post__meta">
        <a href="{{ ('/temas/' + (tema | slugify) + '/') | url }}" class="post__tema-tag">{{ temasMeta[tema].etiqueta }}</a>
        <span class="post__dot">·</span>
        <a href="{{ ('/escuelas/' + (escuela | slugify) + '/') | url }}" class="post__escuela-tag">{{ escuelasMeta[escuela].etiqueta }}</a>
      </div>
      <h1 class="post__title">{{ title }}</h1>
      <p class="post__subline">
        <time datetime="{{ page.date | htmlDateString }}">{{ page.date | fechaEs }}</time>
        <span class="post__dot">·</span>
        <span>{{ content | tiempoLectura }} min de lectura</span>
      </p>
    </header>

    {% include "partials/ad-banner.njk" %}

    <nav class="toc" id="toc" aria-label="En este ensayo" hidden>
      <p class="toc__title">En este ensayo</p>
      <ol class="toc__list" id="toc-list"></ol>
    </nav>

    <div class="post__body" id="post-body">
      {{ content | safe }}
    </div>

    <div class="share" data-title="{{ title | escape }}" data-url="{{ site.url }}{{ page.url }}">
      <span class="share__label">Compartir</span>
      <a class="share__btn" data-share="whatsapp" href="https://wa.me/?text={{ (title + ' ' + site.url + page.url) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
      <a class="share__btn" data-share="x" href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ (site.url + page.url) | urlencode }}" target="_blank" rel="noopener">X</a>
      <a class="share__btn" data-share="facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ (site.url + page.url) | urlencode }}" target="_blank" rel="noopener">Facebook</a>
      <button class="share__btn" type="button" id="copy-link">Copiar enlace</button>
    </div>

    <aside class="author-box">
      <span class="author-box__mark" aria-hidden="true">A</span>
      <div>
        <p class="author-box__name">A ras de suelo</p>
        <p class="author-box__text">Filosofía aplicada a problemas de hoy: un ensayo breve, una escuela de pensamiento y algo concreto que hacer el lunes por la mañana. <a href="{{ '/sobre/' | url }}">Más sobre el proyecto</a>.</p>
      </div>
    </aside>
  </div>

  {% set relacionados = collections.ensayos | relacionados(tema, escuela, page.inputPath, 3) %}
  {% if relacionados.length %}
  <aside class="related">
    <div class="wrap wrap--narrow">
      <h2 class="related__title">Sigue leyendo</h2>
      <div class="related__grid">
        {% for r in relacionados %}
        <a href="{{ r.url | url }}" class="related__card" style="--tema-color: {{ temasMeta[r.data.tema].color }};">
          <img src="{{ r.data.heroImage | url }}" alt="" class="related__card-img" loading="lazy">
          <span class="related__card-body">
            <span class="related__card-tag">{{ temasMeta[r.data.tema].etiqueta }}</span>
            <span class="related__card-title">{{ r.data.title }}</span>
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
  </aside>
  {% endif %}

  {% if site.giscus.repoId and site.giscus.repoId.indexOf('PON_AQUI') == -1 %}
  <div class="wrap wrap--narrow">
    <section class="comments" id="comentarios">
      <h2 class="comments__title">Comentarios</h2>
      <script src="https://giscus.app/client.js"
        data-repo="{{ site.giscus.repo }}"
        data-repo-id="{{ site.giscus.repoId }}"
        data-category="{{ site.giscus.category }}"
        data-category-id="{{ site.giscus.categoryId }}"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="es"
        crossorigin="anonymous"
        async>
      </script>
    </section>
  </div>
  {% endif %}
</article>
