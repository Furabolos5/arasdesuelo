<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" href="data:,">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  {% if site.adsense.publisherId %}
  <meta name="google-adsense-account" content="{{ site.adsense.publisherId }}">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsense.publisherId }}" crossorigin="anonymous"></script>
  {% endif %}
</head>
<body>
  <div class="progress-bar" id="progress-bar"></div>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a href="{{ '/' | url }}" class="site-header__brand">{{ site.title }}</a>
      <nav class="site-header__nav">
        <a href="{{ '/ensayos/' | url }}">Ensayos</a>
        <a href="{{ '/temas/' | url }}">Temas</a>
        <button type="button" class="search-trigger" id="search-trigger" aria-haspopup="dialog">Buscar</button>
      </nav>
    </div>
  </header>

  <div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Buscar ensayos" hidden>
    <div class="search-overlay__panel">
      <input type="text" id="search-input" class="search-overlay__input" placeholder="Buscar por palabra, tema o escuela filosófica…" autocomplete="off">
      <button type="button" class="search-overlay__close" id="search-close" aria-label="Cerrar búsqueda">✕</button>
      <div class="search-overlay__results" id="search-results"></div>
    </div>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>{{ site.title }} — {{ site.tagline }}.</p>
      <p class="site-footer__fine">Un ensayo nuevo, sin ruido. Sin academicismo. <a href="{{ '/privacidad/' | url }}">Privacidad y cookies</a>.</p>
    </div>
  </footer>

  {% include "partials/ad-corner.njk" %}
  {% include "partials/ad-popup.njk" %}

  <script>window.SITE_BASE = "{{ '/' | url }}"; window.SEARCH_INDEX_URL = "{{ '/search-index.json' | url }}";</script>
  <script src="{{ '/js/main.js' | url }}" defer></script>
  <script src="{{ '/js/search.js' | url }}" defer></script>
</body>
</html>
